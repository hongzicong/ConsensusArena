package __PACKAGE__

import (
	"errors"

	"github.com/hongzicong/ConsensusArena/replica/defs"
	"github.com/hongzicong/ConsensusArena/state"
)

var ErrNotImplemented = errors.New("__PACKAGE__: implement the protocol design before enabling it")

type request struct { ID defs.RequestID; Command state.Command }

// outbound carries the native Message through its generated local alias.
// Wire fields belong in messages.proto.
type outbound struct { To int; Message message }
type completion struct { ID defs.RequestID; Value state.Value }

// Outputs are owned by the runtime once a transition returns. The protocol
// decides recipients and completion evidence; transport only delivers outputs.
type effects struct { Sends []outbound; Replies []completion }
