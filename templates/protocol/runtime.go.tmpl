package __PACKAGE__

import (
	"time"

	"github.com/hongzicong/ConsensusArena/protocol"
	"github.com/hongzicong/ConsensusArena/replica/defs"
)

// run owns event delivery and timer lifecycle. Protocol decisions stay in core.
func (r *Replica) run() {
	r.ClientReplyCapacity = 8192
	r.ConnectToPeers()
	r.peers = r.PeerSenders
	defer r.CloseSenders()
	go r.WaitForClientConnections()
	ticker := time.NewTicker(runtimeInterval)
	defer ticker.Stop()
	for {
		var err error
		select {
		case p := <-r.ProposeChan:
			err = r.Propose(p, time.Now())
		case raw := <-r.inbox:
			err = r.Step(raw, time.Now())
		case now := <-ticker.C:
			err = r.Tick(protocol.Tick{Now: now})
		}
		if err != nil {
			r.Printf("PROTOCOL_ERROR error=%q", err)
			return
		}
	}
}

// Public framework adapters validate inputs, call core, and dispatch its effects.
var _ protocol.Machine = (*Replica)(nil)

func (r *Replica) Propose(p *defs.GPropose, now time.Time) error {
	if err := protocol.ValidateProposal(p); err != nil {
		return err
	}
	id := p.RequestID()
	r.proposals[id] = p
	out, err := r.core.submit(request{ID: id, Command: p.Command}, now)
	if err != nil {
		return err
	}
	return r.dispatch(out)
}

func (r *Replica) Step(event any, now time.Time) error {
	m, ok := event.(*message)
	if !ok || m == nil {
		return protocol.UnsupportedEvent("__PACKAGE__", event)
	}
	out, err := r.core.receive(*m, now)
	if err != nil {
		return err
	}
	return r.dispatch(out)
}

func (r *Replica) Tick(t protocol.Tick) error {
	if t.Kind != protocol.Maintenance {
		return protocol.UnsupportedTimer("__PACKAGE__", t.Kind)
	}
	out, err := r.core.tick(t.Now)
	if err != nil {
		return err
	}
	return r.dispatch(out)
}
